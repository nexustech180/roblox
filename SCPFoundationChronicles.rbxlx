<Item class="StarterPlayer" referent="RBX000040"><Properties><string name="Name">StarterPlayer</string></Properties>
<Item class="StarterPlayerScripts" referent="RBX000041"><Properties><string name="Name">StarterPlayerScripts</string></Properties>
