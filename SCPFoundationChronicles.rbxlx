		Objectives = {
			{ Type = "EliminateNPCCount", BaseCount = 4, Description = "Eliminate the Foundation patrol." },
		},
		BaseRewardCredits = 80,
		BaseRewardXP = 160,
	},
	FreeThePrisoners = {
		Id = "FreeThePrisoners",
